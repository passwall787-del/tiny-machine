; Tiny Machine P0
; Godot 4.x Android prototype
config_version=5

[application]
config/name="Tiny Machine P0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.055, 0.063, 0.078, 1)
boot_splash/image=""

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
toggle_run={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":32)]}
reset={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":82)]}
